    -- Funcionalidades

    -- ESP Caixa (quadrado colorido arco-íris)
    local boxESPObjects = {}
    local rainbowHue = 0

    local function updateRainbowESP()
        if not espBoxEnabled then return end
        rainbowHue = (rainbowHue + 0.02) % 1
        local color = Color3.fromHSV(rainbowHue, 1, 1)
        for _, obj in pairs(boxESPObjects) do
            if obj and obj.Parent then
                -- Para cada jogador, atualiza cor da caixa
                for _, part in pairs(obj:GetChildren()) do
                    if part:IsA("BoxHandleAdornment") then
                        part.Color3 = color
                    end
                end
            end
        end
    end

    local function createBoxESP()
        for _, otherPlayer in pairs(Players:GetPlayers()) do
            if otherPlayer ~= player and otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
                if not boxESPObjects[otherPlayer] then
                    local char = otherPlayer.Character
                    local hrp = char.HumanoidRootPart
                    local box = Instance.new("BoxHandleAdornment")
                    box.Size = Vector3.new(4, 5, 2)
                    box.Adornee = hrp
                    box.AlwaysOnTop = true
                    box.ZIndex = 10
                    box.Visible = true
                    box.Parent = hrp
                    boxESPObjects[otherPlayer] = box
                end
            end
        end
    end

    local function clearBoxESP()
        for player, box in pairs(boxESPObjects) do
            if box and box.Parent then
                box:Destroy()
            end
        end
        table.clear(boxESPObjects)
    end

    -- ESP Esqueleto (linhas coloridas entre as juntas)
    local skeletonLines = {}
    local function createSkeletonESP()
        for _, otherPlayer in pairs(Players:GetPlayers()) do
            if otherPlayer ~= player and otherPlayer.Character then
                local char = otherPlayer.Character
                local joints = {
                    {"Head", "UpperTorso"},
                    {"UpperTorso", "LowerTorso"},
                    {"LowerTorso", "HumanoidRootPart"},
                    {"LeftUpperArm", "LeftLowerArm"},
                    {"LeftLowerArm", "LeftHand"},
                    {"RightUpperArm", "RightLowerArm"},
                    {"RightLowerArm", "RightHand"},
                    {"LeftUpperLeg", "LeftLowerLeg"},
                    {"LeftLowerLeg", "LeftFoot"},
                    {"RightUpperLeg", "RightLowerLeg"},
                    {"RightLowerLeg", "RightFoot"}
                }
                for _, joint in pairs(joints) do
                    local partA = char:FindFirstChild(joint[1])
                    local partB = char:FindFirstChild(joint[2])
                    if partA and partB then
                        local line = Instance.new("SelectionBox")
                        line.Adornee = partA
                        line.Color3 = Color3.fromHSV(math.random(), 1, 1)
                        line.Transparency = 0.5
                        line.LineThickness = 0.1
                        line.Parent = partA
                        if not skeletonLines[otherPlayer] then skeletonLines[otherPlayer] = {} end
                        table.insert(skeletonLines[otherPlayer], line)
                    end
                end
            end
        end
    end

    local function clearSkeletonESP()
        for player, lines in pairs(skeletonLines) do
            for _, line in pairs(lines) do
                if line and line.Parent then
                    line:Destroy()
                end
            end
        end
        table.clear(skeletonLines)
    end

